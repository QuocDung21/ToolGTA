<Window x:Class="ToolCSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="⚡ LŨ QUỶ RP - AUTO FISHING TOOL PRO (.NET C#)" Height="720" Width="920"
        MinHeight="680" MinWidth="860" Background="#11111B" WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabItem Style -->
        <Style TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="#1E1E2E" CornerRadius="6,6,0,0" Margin="2,0,2,0" Padding="14,8">
                            <ContentPresenter ContentSource="Header" TextBlock.Foreground="#CDD6F4" TextBlock.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#89B4FA"/>
                                <Setter Property="Foreground" Value="#11111B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="10" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🎣 AUTO FISHING BOT — LŨ QUỶ RP (.NET 10 C#)" Foreground="#CBA6F7" FontSize="19" FontWeight="Bold"/>
                    <TextBlock Text="Chế độ: Bạn tự quăng cần • Tool tự động nhận diện &amp; giải QTE 5 mũi tên" Foreground="#A6ADC8" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
                
                <Border x:Name="BorderStatus" HorizontalAlignment="Right" Background="#1E1E2E" CornerRadius="8" Padding="14,6">
                    <TextBlock x:Name="TxtMainStatus" Text="● SẴN SÀNG (IDLE)" Foreground="#A6ADC8" FontFamily="Consolas" FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Tabs -->
        <TabControl Grid.Row="1" Background="#181825" BorderThickness="0">
            
            <!-- TAB 1: DASHBOARD -->
            <TabItem Header="  📊 Bảng Điều Khiển  ">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Metrics Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Metric 1 -->
                        <Border Grid.Column="0" Background="#1E1E2E" CornerRadius="8" Padding="12,8" Margin="0,0,4,0">
                            <StackPanel>
                                <TextBlock Text="🎣 Cá Đã Câu" Foreground="#A6ADC8" FontSize="11"/>
                                <TextBlock x:Name="TxtFishCount" Text="0" Foreground="#A6E3A1" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 2 -->
                        <Border Grid.Column="1" Background="#1E1E2E" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="⚡ QTE Thành Công" Foreground="#A6ADC8" FontSize="11"/>
                                <TextBlock x:Name="TxtSolvedCount" Text="0" Foreground="#89DCEB" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 3 -->
                        <Border Grid.Column="2" Background="#1E1E2E" CornerRadius="8" Padding="12,8" Margin="4,0,4,0">
                            <StackPanel>
                                <TextBlock Text="⏱️ Thời Gian Chạy" Foreground="#A6ADC8" FontSize="11"/>
                                <TextBlock x:Name="TxtUptime" Text="00:00:00" Foreground="#F9E2AF" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Metric 4 -->
                        <Border Grid.Column="3" Background="#1E1E2E" CornerRadius="8" Padding="12,8" Margin="4,0,0,0">
                            <StackPanel>
                                <TextBlock Text="🎯 Tỉ Lệ Chuẩn" Foreground="#A6ADC8" FontSize="11"/>
                                <TextBlock Text="100%" Foreground="#CBA6F7" FontFamily="Consolas" FontSize="20" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Control Buttons Row -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnToggleStart" Grid.Column="0" Content="▶  BẮT ĐẦU (F1)" Height="42" Background="#2E7D32" 
                                Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="BtnToggleStart_Click"/>
                        
                        <Button x:Name="BtnTogglePause" Grid.Column="1" Content="⏸  TẠM DỪNG (F2)" Height="42" Background="#D97706" 
                                Style="{StaticResource ActionButton}" Margin="3,0,3,0" Click="BtnTogglePause_Click"/>
                        
                        <Button x:Name="BtnPanic" Grid.Column="2" Content="🚨  KHẨN CẤP (F3)" Height="42" Background="#DC2626" 
                                Style="{StaticResource ActionButton}" Margin="6,0,0,0" Click="BtnPanic_Click"/>
                    </Grid>

                    <!-- Key Check & Movement Diagnostic Row -->
                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnKeyCheck" Grid.Column="0" Content="🎮  BẬT THEO DÕI NÚT DI CHUYỂN (F4)" Height="34" Background="#45475A" 
                                Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="BtnKeyCheck_Click"/>
                        
                        <Button x:Name="BtnTestMove" Grid.Column="1" Content="🚀  TEST GỬI PHÍM DI CHUYỂN" Height="34" Background="#313244" 
                                Style="{StaticResource ActionButton}" Margin="3,0,6,0" Click="BtnTestMove_Click"/>

                        <CheckBox x:Name="ChkOverlay" Grid.Column="2" Content="Bật Game HUD Mini" Foreground="#CDD6F4" 
                                  FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0" Click="ChkOverlay_Click"/>
                    </Grid>

                    <!-- Arrow Sequence Box -->
                    <Border Grid.Row="3" Background="#11111B" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DÃY MŨI TÊN NHẬN DIỆN GẦN NHẤT:" Foreground="#89B4FA" FontFamily="Consolas" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TxtSequenceDisplay" Text="[  CHƯA PHÁT HIỆN MINIGAME  ]" Foreground="#6C7086" 
                                       FontFamily="Consolas" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Live Log Console -->
                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <TextBlock Text="Nhật Ký Hoạt Động (Live Console):" Foreground="#CDD6F4" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="📄 Mở File Log" Background="#313244" Foreground="#CDD6F4" FontSize="11" Padding="8,2" Margin="0,0,6,0" Click="BtnOpenLogFile_Click"/>
                                <Button Content="📁 Thư Mục Log" Background="#313244" Foreground="#CDD6F4" FontSize="11" Padding="8,2" Margin="0,0,6,0" Click="BtnOpenLogDir_Click"/>
                                <Button Content="Xóa log" Background="#313244" Foreground="#CDD6F4" FontSize="11" Padding="8,2" Click="BtnClearLog_Click"/>
                            </StackPanel>
                        </Grid>

                        <TextBox x:Name="TxtLogs" Grid.Row="1" Background="#11111B" Foreground="#CDD6F4" 
                                 FontFamily="Consolas" FontSize="11" BorderThickness="0" Padding="8" 
                                 IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: CONFIG -->
            <TabItem Header="  ⚙️ Phím &amp; Độ Trễ  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="⌨️ CẤU HÌNH PHÍM BẤM" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Phím Cần Câu (Slot túi đồ):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbRodKey" Text="1" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Phím Tắt Bật/Tắt Bot:" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbHkStart" Text="F1" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Phím Tắt Tạm Dừng Bot:" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbHkPause" Text="F2" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Phím Tắt Khẩn Cấp (Panic Exit):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbHkPanic" Text="F3" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                 </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Tự động quăng lại cần (Tắt để bạn tự quăng cần tay):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ChkAutoRecast" IsChecked="False" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="⏳ ĐỘ TRỄ MÔ PHỎNG NGƯỜI THẬT (CHỐNG PHÁT HIỆN)" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Thời gian giữ phím tối thiểu (ms):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbMinPress" Text="65" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Thời gian giữ phím tối đa (ms):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbMaxPress" Text="115" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Khoảng cách giữa các phím tối thiểu (ms):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbMinInterval" Text="90" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Khoảng cách giữa các phím tối đa (ms):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbMaxInterval" Text="160" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Thời gian kéo cá lên (giây):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbReelWait" Text="4.5" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                                <Grid Margin="0,4">
                                    <TextBlock Text="Thời gian chờ quăng lại cần (giây):" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                    <TextBox x:Name="TbRecastWait" Text="2.0" Width="100" HorizontalAlignment="Right" Background="#11111B" Foreground="#CDD6F4" Padding="6,3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="💾  LƯU CẤU HÌNH" Background="#89B4FA" Foreground="#11111B" Style="{StaticResource ActionButton}" 
                                    Margin="0,0,8,0" Click="BtnSaveConfig_Click"/>
                            <Button Content="🔄  TẢI LẠI TỪ FILE" Background="#313244" Foreground="#CDD6F4" Style="{StaticResource ActionButton}" 
                                    Click="BtnReloadConfig_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: VISION -->
            <TabItem Header="  👁️ Thị Giác &amp; Mẫu  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="🎯 TRẠNG THÁI 4 MẪU MŨI TÊN (TEMPLATES)" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#11111B" CornerRadius="6" Padding="8" Margin="0,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⬆ MŨI TÊN LÊN" Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTplUp" Text="[KIỂM TRA...]" Foreground="#F9E2AF" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" Background="#11111B" CornerRadius="6" Padding="8" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⬇ MŨI TÊN XUỐNG" Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTplDown" Text="[KIỂM TRA...]" Foreground="#F9E2AF" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="#11111B" CornerRadius="6" Padding="8" Margin="4,0,4,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="⬅ MŨI TÊN TRÁI" Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTplLeft" Text="[KIỂM TRA...]" Foreground="#F9E2AF" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="#11111B" CornerRadius="6" Padding="8" Margin="4,0,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="➡ MŨI TÊN PHẢI" Foreground="#A6ADC8" FontSize="11" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTplRight" Text="[KIỂM TRA...]" Foreground="#F9E2AF" FontWeight="Bold" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="📷 CÔNG CỤ TRÍCH XUẤT MẪU TỰ ĐỘNG" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Chọn bức ảnh chụp màn hình minigame câu cá để tự động lọc màu đỏ và cắt 4 template chuẩn." 
                                           Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,10"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁  Chọn Ảnh Mẫu &amp; Tự Động Trích Xuất" Background="#CBA6F7" Foreground="#11111B" 
                                            Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnExtractTemplates_Click"/>
                                    <Button Content="🔍  Chạy Thử Nghiệm Nhận Diện" Background="#313244" Foreground="#CDD6F4" 
                                            Style="{StaticResource ActionButton}" Click="BtnTestDetector_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="🎚️ ĐỘ NHẠY SO KHỚP (MATCH THRESHOLD)" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <Slider x:Name="SliderThreshold" Minimum="0.50" Maximum="0.95" Value="0.72" 
                                        TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="SliderThreshold_ValueChanged"/>
                                <TextBlock x:Name="TxtThresholdVal" Text="Ngưỡng hiện tại: 0.72 (Khuyến nghị: 0.65 - 0.75)" 
                                           Foreground="#89DCEB" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: STEALTH -->
            <TabItem Header="  🛡️ Chống Ban &amp; Cảnh Báo  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="12">
                    <StackPanel>
                        <TextBlock Text="🛡️ CƠ CHẾ CHỐNG AFK &amp; HÀNH VI NGƯỜI THẬT" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                            <CheckBox x:Name="ChkAntiAfk" Content="Bật tính năng Anti-AFK (Nhấp nhẹ phím / vi thao tác ngẫu nhiên)" 
                                      Foreground="#CDD6F4" IsChecked="True" FontSize="12"/>
                        </Border>

                        <TextBlock Text="🔔 CẢNH BÁO TỪ XA QUA DISCORD WEBHOOK" Foreground="#89B4FA" FontWeight="Bold" FontSize="13" Margin="0,4,0,6"/>
                        <Border Background="#1E1E2E" CornerRadius="8" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="Nhập URL Webhook để nhận cảnh báo về điện thoại khi có sự cố hoặc bot ngắt khẩn cấp." 
                                           Foreground="#A6ADC8" FontSize="11" Margin="0,0,0,8"/>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TbWebhookUrl" Grid.Column="0" Background="#11111B" Foreground="#CDD6F4" Padding="8,4" Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Content="Test Gửi" Background="#313244" Foreground="#CDD6F4" Style="{StaticResource ActionButton}" Click="BtnTestWebhook_Click"/>
                                </Grid>
                                <CheckBox x:Name="ChkSoundAlarm" Content="Phát còi báo động (Beep Sound) khi có sự cố" Foreground="#CDD6F4" IsChecked="True" FontSize="12"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="Transparent" Margin="0,8,0,0">
            <TextBlock Text="💡 Mẹo: Nhấn F1 trong game để bắt đầu. Nhấn F3 bất kỳ lúc nào để ngắt khẩn cấp." 
                       Foreground="#6C7086" FontSize="11"/>
        </Border>
    </Grid>
</Window>
