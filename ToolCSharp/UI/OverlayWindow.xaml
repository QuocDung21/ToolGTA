<Window x:Class="ToolCSharp.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoFish HUD" Height="100" Width="260"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        Left="40" Top="40" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Border Background="#EE181825" BorderBrush="#CBA6F7" BorderThickness="1.5" CornerRadius="8">
        <Grid Margin="8,4,8,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <TextBlock Text="⚡ AUTO FISH HUD (C#)" Foreground="#CBA6F7" FontWeight="Bold" FontSize="11"/>
                <Button Content="✕" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" 
                        Foreground="#F38BA8" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click"/>
            </Grid>

            <!-- Status -->
            <TextBlock x:Name="TxtStatus" Grid.Row="1" Text="STATUS: READY (F1)" Foreground="#A6ADC8" 
                       FontFamily="Consolas" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Margin="0,3,0,1"/>

            <!-- Details -->
            <TextBlock x:Name="TxtDetails" Grid.Row="2" Text="Fish: 0  |  Solved: 0" Foreground="#89DCEB" 
                       FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" Margin="0,1"/>

            <!-- Arrows -->
            <TextBlock x:Name="TxtArrows" Grid.Row="3" Text="Arrows: [WAITING]" Foreground="#F9E2AF" 
                       FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center" Margin="0,1"/>
        </Grid>
    </Border>
</Window>
